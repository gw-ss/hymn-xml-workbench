        <mxCell id="phase1" value="FOUNDATION" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="450" height="650" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1  Evidence schema + provenance&#xa;Define photo-backed items, confidence, crop and decision history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase1">
          <mxGeometry x="30" y="65" width="390" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2  Sidebar photo loader + busy state&#xa;Load, preview, process, accept/warn/reject with reasons." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase1">
          <mxGeometry x="30" y="175" width="390" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3  Preprocessing + quality gate&#xa;Deskew, contrast variants, staff detection and clarity scoring." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase1">
          <mxGeometry x="30" y="285" width="390" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gate1" value="GATE A&#xa;Known clear photo accepted; degraded and ambiguous photos warn or reject reproducibly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="phase1">
