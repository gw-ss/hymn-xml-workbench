        <mxCell id="gate3" value="GATE C&#xa;User can audit every emitted A/T/B item back to photo evidence or an explicit correction; regression suite passes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="phase3">
