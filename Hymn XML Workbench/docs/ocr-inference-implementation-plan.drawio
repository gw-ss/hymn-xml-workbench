        <mxCell id="m7" value="7  Inference engine&#xa;Check harmony, range, voice-leading, timing and engraving consistency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase3">
