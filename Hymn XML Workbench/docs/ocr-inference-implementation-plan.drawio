          <mxGeometry x="560" y="130" width="450" height="650" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4  Soprano-guided staff registration&#xa;Align the photo to known measure, beat and onset geometry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase2">
          <mxGeometry x="30" y="65" width="390" height="85" as="geometry" />
