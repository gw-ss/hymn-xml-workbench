        <mxCell id="m9" value="9  Evidence-gated MusicXML write&#xa;Write accepted items and provenance; keep unresolved items blocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase3">
