        <mxCell id="gate2" value="GATE B&#xa;Hymn 1 fixture reproduces supported pitch, timing, beam direction and shared-line geometry without invented symbols." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="phase2">
          <mxGeometry x="30" y="420" width="390" height="100" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="VERIFICATION + CONTROLLED EMISSION" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1070" y="130" width="450" height="650" as="geometry" />
