        <mxCell id="m5" value="5  Symbol + geometry recognition&#xa;A/T/B notes, rests, accidentals, stems, beams, overlaps and shared connections." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase2">
          <mxGeometry x="30" y="175" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6  Independent reader comparison&#xa;Preserve disagreement instead of averaging it away." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1F2937;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="phase2">
